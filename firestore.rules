rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // STRICT PER-USER DATA ISOLATION
    // Only authenticated users can access their own root document and subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // User's private journal sessions and reflection history
      match /sessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        
        match /messages/{messageId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      // User's cognitive micro-action plan
      match /action_items/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // User's emotional pulse check-ins
      match /emotional_checkins/{checkinId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Default deny-all for any other collections or cross-tenant queries
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
